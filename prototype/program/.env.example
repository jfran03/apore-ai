# Copy this file to .env and fill in your keys.
# Optional bootstrap keys. You can also add keys from Settings in the client.
# Settings keys are persisted to program/.apore/config.json.

# --- Anthropic ---
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- NVIDIA NIM ---
# Get from: https://build.nvidia.com (free tier, ~40 RPM)
NVIDIA_API_KEY=nvapi-...

# --- Client (optional) ---
# Only needed if the API runs on a non-default host/port.
# Default: http://localhost:8000
# VITE_API_BASE_URL=http://localhost:8000
